DATABASE_URL=postgresql://grantrx:grantrx@localhost:5432/grantrx
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Server environment — "development" enables dev-mode auth fallback
# (accepts demo token "grantrx-dev-demo" and injects demo user UUID)
ENVIRONMENT=development

# Scraper / LLM fallback
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Or use LiteLLM instead of OpenAI:
# LITELLM_MODEL=anthropic/claude-3-5-sonnet
# LITELLM_API_KEY=...
# LITELLM_BASE_URL=
# Optional: path to a JSON file overriding scrapers/sources.py
# GRANTRX_SOURCES_JSON=/path/to/sources.json

# Stripe billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
APP_BASE_URL=http://localhost:8000
