DATABASE_URL=postgresql://grantrx:grantrx@localhost:5432/grantrx
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service-role key — server-side only. Required for Supabase-admin account
# deletion. Never expose this to the frontend.
SUPABASE_KEY=your-supabase-service-role-key

# Server environment — "development" enables dev-mode auth fallback
# (accepts demo token "grantrx-dev-demo" and injects demo user UUID)
ENVIRONMENT=development
ALLOW_DEMO_AUTH=false

# Scraper / LLM fallback
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Or use LiteLLM instead of OpenAI:
# LITELLM_MODEL=anthropic/claude-3-5-sonnet
# LITELLM_API_KEY=...
# LITELLM_BASE_URL=
# Optional: path to a JSON file overriding scrapers/sources.py
# GRANTRX_SOURCES_JSON=/path/to/sources.json

# Stripe billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
# Canonical runtime URLs. Production example:
# APP_URL=https://grantrx.com
# API_BASE_URL=https://api.grantrx.com
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
PORTAL_RETURN_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Branded identities
TRANSACTIONAL_FROM_EMAIL=hello@grantrx.com
DIGEST_FROM_EMAIL=digest@grantrx.com
PRIVACY_EMAIL=privacy@grantrx.com
CALENDAR_UID_DOMAIN=grantrx.com

# EmailOctopus — early-access/waitlist marketing sync (R3).
# Server-side only. When unset, waitlist signups still persist to the
# database and the lead's provider_sync_status is marked 'skipped'.
# EMAILOCTOPUS_API_KEY=
# EMAILOCTOPUS_LIST_ID=
# EMAILOCTOPUS_BASE_URL=https://emailoctopus.com/api/1.5
# EMAILOCTOPUS_TIMEOUT=5

# Public early-access signup rate limiting (per client host, in-memory)
# EARLY_ACCESS_RATE_LIMIT=10
# EARLY_ACCESS_RATE_WINDOW_SECONDS=300
